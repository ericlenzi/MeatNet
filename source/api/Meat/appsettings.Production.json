{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  // Los secretos y lo propio del servidor van por variables de entorno (ver docs/infraestructure.md):
  //   ConnectionStrings__Default, JwtOptions__SigninKey, Cors__Origins__0, TZ
  "ConnectionStrings": {
  },
  "JwtOptions": {
    "Issuer": "meatnet-api",
    "Audience": "meatnet-web",
    "ValidFor": "1200" //Minutes
  },
  "Cors": {
    // Origenes del frontend (dominio de Vercel). Sin origenes, ningun navegador puede llamar a la API.
    "Origins": []
  },
  "isApiLocal": false
}
